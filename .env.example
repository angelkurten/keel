# Keel configuration. Copy to .env and fill in what you use; `keel` loads ./.env (or --env-file).
# Variables already set in the environment win over this file; a command-line flag beats both.

# The durable graph: a SQLite file or mysql://user:pass@host:3306/db
# KEEL_DB=keel.db

# The default tenant for every command, and the tenant `keel serve` is bound to.
# A product with no end-customers sets one fixed value (events still carry it).
# KEEL_TENANT=default

# The declared agent acting here (required when the cartridge declares agents:)
# KEEL_AGENT=

# keel serve --transport http: the shared bearer secret
# KEEL_SECRET=

# keel serve --transport http: TLS (add --http2 for HTTP/2, uv sync --extra http2)
# KEEL_CERTFILE=
# KEEL_KEYFILE=

# Semantic search: vector index and embedder specs (memory, chroma:///path, hash, openai, pkg.module:factory?k=v)
# KEEL_INDEX=chroma:///var/keel/vectors
# KEEL_EMBEDDER=openai

# --embedder openai: any OpenAI-compatible /v1/embeddings endpoint
# KEEL_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# KEEL_EMBEDDINGS_MODEL=text-embedding-3-small
# KEEL_EMBEDDINGS_API_KEY=
# KEEL_EMBEDDINGS_QUERY_PREFIX=
# KEEL_EMBEDDINGS_DOCUMENT_PREFIX=

# serve --reranker http|llm
# KEEL_RERANK_BASE_URL=
# KEEL_RERANK_MODEL=
# KEEL_RERANK_API_KEY=

# consolidate --summarizer llm
# KEEL_SUMMARIZER_BASE_URL=
# KEEL_SUMMARIZER_MODEL=
# KEEL_SUMMARIZER_API_KEY=
